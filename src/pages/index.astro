---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaButtons from '../components/CtaButtons.astro';
import Photo from '../components/Photo.astro';
import TrustStrip from '../components/TrustStrip.astro';
import StageDiagram from '../components/StageDiagram.astro';
import ServiceCards from '../components/ServiceCards.astro';
import Steps from '../components/Steps.astro';
import Testimonials from '../components/Testimonials.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { REGIONS, SUBURBS, areaUrl } from '../data/areas';
import { HOME_FAQS } from '../data/faqs';
import { REVIEWS } from '../data/reviews';
import type { PhotoKey } from '../data/photos';
import { SITE, hasReviewUrl } from '../config/site';
import { website } from '../lib/schema';
import { quoteTime, recleanTime } from '../lib/text';

const work: PhotoKey[] = ['living-dining', 'kitchen', 'bathroom-handover', 'stairs', 'pantry', 'pool'];
const priceFactors = [
  ['Floor area', 'The single biggest factor. More square metres means more surface to clean.'],
  ['Levels', 'Stairs, balustrades and a second set of wet areas add time.'],
  ['Glazing', 'Floor-to-ceiling glass, sliding doors and window count change the job a lot.'],
  ['Finishes', 'Stone, polished concrete and dark tiles need slower, surface-specific methods.'],
  ['Access', 'Lifts, loading docks, parking and stairs in apartment buildings.'],
  ['Build stage', 'A rough clean, a final clean and a sparkle clean are different jobs, and residue changes the scope.'],
  ['Time of day', 'After-hours, overnight and weekend work for fit-outs and tight programs.'],
];
---
<BaseLayout
  title="Builders Clean Brisbane | Post Construction Cleaning | Builders Clean Brisbane Co."
  description="Builders clean Brisbane for builders and homeowners. Rough, final and handover cleans with itemised quotes, flexible scheduling and photo reports. Get a quote."
  schema={[website()]}
>
  <!-- Hero: on mobile H1 → promise → buttons → photo → meta -->
  <section class="hero on-teal">
    <div class="wrap hero__grid">
      <div class="hero__copy">
        <p class="eyebrow">Brisbane’s builders clean specialists</p>
        <h1>Builders Clean Brisbane</h1>
        <p class="hero__promise">On the handover date, to handover standard, with photos to prove it.</p>
        <CtaButtons on="teal" showWhatsapp heroFallback class="hero__actions" />
      </div>
      <div class="hero__media">
        <Photo photo="polished-concrete" caption={false} eager crop={[3, 2]} sizes="(min-width: 900px) 52vw, 100vw" widths={[360, 540, 720, 860, 1080, 1280]}
          alt="Polished concrete floor cleaned after construction in a Brisbane home, ready for handover" />
      </div>
      <ul class="hero__meta">
        <li>Rough, final and handover cleans</li>
        <li>Builders and homeowners</li>
        <li>Brisbane, Moreton Bay, Logan, Ipswich, Redlands</li>
      </ul>
    </div>
  </section>

  <!-- Answer-first intro + builder / homeowner split -->
  <section class="section section--soft who" aria-labelledby="who-h">
    <div class="wrap">
      <div class="who__grid">
        <div class="who__intro answer">
          <p class="eyebrow">Who we clean for</p>
          <p>
            Builders Clean Brisbane Co. is a Brisbane builders cleaning company that cleans new homes, renovations, apartments and fit-outs for
            builders and homeowners across Brisbane, Moreton Bay, Logan, Ipswich and the Redlands. A builders clean removes the dust, residue,
            stickers and debris that trades leave behind, so the home is ready for handover, inspection or move-in.
          </p>
          <p>
            Our builders cleaning in Brisbane is quoted room by room within {quoteTime()}, booked around your program, checked by a supervisor
            and finished with a photo report. Builders cleaning is all we do.
          </p>
        </div>
        <div class="who__paths">
          <h2 id="who-h" class="who__title">Builder or homeowner?</h2>
          <p class="who__lead">Pick your path. Same crews, same handover standard — different booking and paperwork.</p>
          <div class="who__cards">
            <a class="who-card who-card--builder" href="/for-builders/">
              <span class="who-card__tag">For builders</span>
              <h3>I’m a builder or site manager</h3>
              <p>Staged cleans to your program, a supervisor sign-off and a photo report your client can see. Documents on request.</p>
              <span class="who-card__more" aria-hidden="true">Builder accounts</span>
            </a>
            <a class="who-card who-card--home" href="/services/new-home-builders-clean-brisbane/">
              <span class="who-card__tag">For homeowners</span>
              <h3>I’m a homeowner or investor</h3>
              <p>The clean you expected before move-in or sale, in plain language, with a quote that lists everything included.</p>
              <span class="who-card__more" aria-hidden="true">New home clean</span>
            </a>
          </div>
          <ul class="who__links">
            <li>Homeowners: <a href="/services/renovation-cleaning-brisbane/">post renovation cleaning</a> · <a href="/builders-clean-cost-brisbane/">price guide</a></li>
            <li>Builders: <a href="/contact/#quote">send plans for a builder quote</a></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <TrustStrip />

  <!-- Three stages -->
  <section class="section section--mist stages-section" aria-labelledby="stages-h">
    <div class="wrap">
      <div class="section-head stages-section__head">
        <p class="eyebrow">The three stages</p>
        <h2 id="stages-h">Builders cleaning in Brisbane, stage by stage</h2>
        <p>
          A build is cleaned more than once. The rough clean keeps the site workable between trades, the final clean takes the home to
          handover standard after the last trade, and the handover or sparkle clean is the last pass before the inspection or move-in.
          Together they make up a full <a href="/services/post-construction-cleaning-brisbane/">post construction cleaning Brisbane</a> service.
        </p>
      </div>
      <StageDiagram />
    </div>
  </section>

  <!-- Services grid -->
  <section class="section svc-section" aria-labelledby="svc-h">
    <div class="wrap">
      <div class="section-head svc-section__head">
        <p class="eyebrow">Services</p>
        <h2 id="svc-h">Every builders clean, from first fix to the keys</h2>
        <p>Seventeen services, grouped by what you need. Each page lists exactly what is included and how we price it.</p>
      </div>
      <ServiceCards />
      <p class="svc-section__cta"><a class="btn btn--ghost" href="/services/">All builders cleaning services</a></p>
    </div>
  </section>

  <!-- Flexibility -->
  <section class="section section--mist flex-section" aria-labelledby="flex-h">
    <div class="wrap flex-section__grid">
      <div class="flex-section__copy">
        <p class="eyebrow">Why builders call us back</p>
        <h2 id="flex-h">Trades run late. Handover dates move. We move with them.</h2>
        <p class="flex-section__lead">
          The thing customers praise most in every set of builders cleaning reviews we studied is flexibility: a crew that still turns up when the
          plasterer runs two days over and the handover date moves. We build our schedule for that.
        </p>
        <ul class="flex-section__points">
          <li>
            <span class="flex-section__point-n" aria-hidden="true">01</span>
            <span>You send the plans and the date. We confirm the slot in writing and remind you before the crew arrives.</span>
          </li>
          <li>
            <span class="flex-section__point-n" aria-hidden="true">02</span>
            <span>If the program moves, tell one contact — we re-book without starting again.</span>
          </li>
          <li>
            <span class="flex-section__point-n" aria-hidden="true">03</span>
            <span>On the day, a supervisor checks the checklist and the photo report lands before you ask.</span>
          </li>
        </ul>
        <p class="flex-section__note">
          For homeowners, the same planning means the clean lands between handover and move-in, not on top of the removalist. For builders, it
          means cleaning drops off the defects list.
        </p>
        <p class="flex-section__cta">
          <a class="btn btn--primary" href="/for-builders/">Builder accounts</a>
          <a class="btn btn--ghost" href="/contact/#quote">Get a free quote</a>
        </p>
      </div>
      <div class="flex-section__media">
        <Photo
          photo="new-home"
          caption={false}
          crop={[3, 4]}
          class="flex-section__img"
          sizes="(min-width: 900px) 45vw, 100vw"
          widths={[360, 540, 720, 860, 1080]}
          alt="New home cleaned before move-in by a builders clean crew in Brisbane"
        />
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="section section--teal on-teal how-section" aria-labelledby="how-h">
    <div class="wrap">
      <div class="section-head how-section__head">
        <p class="eyebrow">How it works</p>
        <h2 id="how-h">From plans to sign-off in five steps</h2>
        <p>Missed something? Tell us within {recleanTime()} and we come back to re-clean any in-scope item.</p>
      </div>
      <Steps />
    </div>
  </section>

  <!-- Price factors -->
  <section class="section section--soft price-section" aria-labelledby="price-h">
    <div class="wrap">
      <div class="price-section__intro">
        <div class="section-head price-section__head">
          <p class="eyebrow">Pricing</p>
          <h2 id="price-h">What changes the price of a builders clean</h2>
          <p>
            Most Brisbane cleaning companies will not publish prices. We would rather show you how we work them out, so you can compare quotes
            on the same scope. Two homes with the same number of bedrooms can need very different amounts of work.
          </p>
          <p>Our <a href="/builders-clean-cost-brisbane/">builders clean cost guide</a> sets out starting prices by property size and stage.</p>
        </div>
        <p class="price-section__cta">
          <a class="btn btn--primary" href="/builders-clean-cost-brisbane/">See the price guide</a>
          <a class="btn btn--ghost" href="/contact/#quote">Get a free quote</a>
        </p>
      </div>
      <dl class="price-factors">
        {priceFactors.map(([k, v], i) => (
          <div class="price-factor">
            <dt>
              <span class="price-factor__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span class="price-factor__title">{k}</span>
            </dt>
            <dd class="price-factor__text">{v}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Our work -->
  <section class="section section--mist work-section" aria-labelledby="work-h">
    <div class="wrap">
      <div class="section-head work-section__head">
        <p class="eyebrow">Our work</p>
        <h2 id="work-h">Real Brisbane jobs, cleaned by our crew</h2>
        <p>Polished concrete, black tile, timber stairs and big glass: the finishes that show every speck of dust. No stock photos.</p>
      </div>
      <div class="work-gallery">
        {work.map((k) => (
          <div class="work-gallery__item">
            <Photo
              photo={k}
              crop={[4, 3]}
              class="work-gallery__photo"
              sizes="(min-width: 960px) 380px, (min-width: 640px) 50vw, 100vw"
              widths={[360, 540, 720, 860]}
            />
          </div>
        ))}
      </div>
      <p class="work-section__cta">
        <a class="btn btn--ghost" href="/our-work/">See all builders clean photos</a>
      </p>
    </div>
  </section>

  <!-- Areas -->
  <section class="section section--soft areas-section" aria-labelledby="areas-h">
    <div class="wrap">
      <div class="section-head areas-section__head">
        <p class="eyebrow">Areas we cover</p>
        <h2 id="areas-h">Builders cleaning across Greater Brisbane</h2>
        <p>From inner-city apartments to the new estates in the growth corridors — five regions, one crew standard.</p>
      </div>
      <div class="areas-grid">
        {REGIONS.map((r) => {
          const suburbs = SUBURBS.filter((s) => s.region === r.slug);
          return (
            <article class="area-card">
              <h3 class="area-card__title"><a href={areaUrl(r.slug)}>{r.name}</a></h3>
              <p class="area-card__blurb">{r.blurb}</p>
              {suburbs.length > 0 && (
                <ul class="area-card__subs">
                  {suburbs.map((s) => (
                    <li><a href={areaUrl(s.slug)}>{s.name}</a></li>
                  ))}
                </ul>
              )}
              {r.slug === 'redland' && suburbs.length === 0 && (
                <p class="area-card__note">Redlands suburbs: ask when you book</p>
              )}
              <a class="area-card__more" href={areaUrl(r.slug)}>View {r.name}</a>
            </article>
          );
        })}
      </div>
      <p class="areas-section__cta">
        <a class="btn btn--primary" href="/areas/">See all service areas</a>
        <a class="btn btn--ghost" href="/contact/#quote">Get a free quote</a>
      </p>
    </div>
  </section>

  <!-- Reviews: real reviews only; otherwise the review CTA -->
  <Testimonials />
  {REVIEWS.length === 0 && (
    <section class="section section--soft section--tight" aria-labelledby="rev-h">
      <div class="wrap split split--center">
        <div>
          <h2 id="rev-h">Had a clean with us?</h2>
          <p>We are a new Brisbane business and every review helps other builders and homeowners find us. Tell people the job type and the suburb.</p>
        </div>
        <div class="btn-row">
          {hasReviewUrl
            ? <a class="btn btn--primary" href={SITE.reviewUrl} rel="noopener"><Icon name="star" />Leave us a Google review</a>
            : <a class="btn btn--primary" href="/reviews/"><Icon name="star" />Leave us a Google review</a>}
          <a class="btn btn--ghost" href="/reviews/">Reviews</a>
        </div>
      </div>
    </section>
  )}

  <!-- FAQ -->
  <section class="section section--mist faq-section" aria-labelledby="faq-h">
    <div class="wrap">
      <div class="section-head faq-section__head">
        <p class="eyebrow">FAQ</p>
        <h2 id="faq-h">Builders clean questions</h2>
        <p>Straight answers on scope, timing, access and what happens if something is missed.</p>
      </div>
      <Faq faqs={HOME_FAQS} openFirst columns={2} />
      <div class="faq-section__foot">
        <p>More answers in the <a href="/faq/">builders clean FAQ</a>.</p>
        <p class="faq-section__cta">
          <a class="btn btn--primary" href="/contact/#quote">Get a free quote</a>
          <a class="btn btn--ghost" href="/faq/">All FAQ answers</a>
        </p>
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
