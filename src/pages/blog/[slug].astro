---
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import Photo from '../../components/Photo.astro';
import CtaButtons from '../../components/CtaButtons.astro';
import Faq from '../../components/Faq.astro';
import CtaBand from '../../components/CtaBand.astro';
import { serviceBySlug, serviceUrl } from '../../data/services';
import { areaBySlug, areaUrl } from '../../data/areas';
import { PHOTOS } from '../../data/photos';
import { breadcrumbList, BUSINESS_ID } from '../../lib/schema';
import { abs } from '../../lib/text';

export const getStaticPaths = (async () => {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

const { post } = Astro.props as { post: CollectionEntry<'blog'> };
const d = post.data;
const { Content } = await render(post);
const url = `/blog/${post.id}/`;
const crumbs = [{ label: 'Home', href: '/' }, { label: 'Guides', href: '/blog/' }, { label: d.h1, href: url }];
const services = d.services.map(serviceBySlug);
const area = areaBySlug(d.area);
const fmt = (dt: Date) => dt.toLocaleDateString('en-AU', { day: 'numeric', month: 'long', year: 'numeric' });
const published = d.pubDate.toISOString().slice(0, 10);
const modified = (d.updated ?? d.pubDate).toISOString().slice(0, 10);

const allPosts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const moreGuides = allPosts.filter((p) => p.id !== post.id).slice(0, 3);

const article = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: d.h1,
  description: d.description,
  datePublished: published,
  dateModified: modified,
  mainEntityOfPage: abs(url),
  inLanguage: 'en-AU',
  author: { '@id': BUSINESS_ID },
  publisher: { '@id': BUSINESS_ID },
  image: abs('/brand/og-image-1200x630.jpg'),
};
---
<BaseLayout
  title={d.title}
  description={d.description}
  schema={[breadcrumbList(crumbs), article]}
  ogImage={PHOTOS[d.photo].src}
  ogType="article"
>
  <PageHead
    crumbs={crumbs}
    h1={d.h1}
    eyebrow="Guide"
    photo={d.photo}
    photoAlt={d.photoAlt}
    meta={[
      'Brisbane builders clean',
      'Plain English',
      fmt(d.pubDate),
    ]}
  >
    <div class="answer">
      <p>{d.summary}</p>
    </div>
    <p class="blog-post-head__byline">
      By the Builders Clean Brisbane Co. team ·
      <time datetime={published}>{fmt(d.pubDate)}</time>
      {d.updated && (
        <>
          {' '}· Updated <time datetime={modified}>{fmt(d.updated)}</time>
        </>
      )}
    </p>
    <CtaButtons on="teal" showWhatsapp heroFallback class="mt-2" />
  </PageHead>

  <article class="section blog-post-body">
    <div class="wrap blog-post-body__layout">
      <div class="blog-post-body__main prose prose--blog">
        <Content />
      </div>

      <aside class="blog-post-aside" aria-label="Related">
        <div class="blog-post-aside__card">
          <p class="eyebrow">Related services</p>
          <h2 class="blog-post-aside__title">Use these next</h2>
          <ul class="blog-post-aside__links">
            {services.map((s) => (
              <li><a href={serviceUrl(s.slug)}>{s.name}</a></li>
            ))}
            <li><a href={areaUrl(area.slug)}>Builders clean {area.name}</a></li>
            <li><a href="/builders-clean-cost-brisbane/">Price guide</a></li>
            <li><a href="/contact/#quote">Get a free quote</a></li>
          </ul>
        </div>
        <div class="blog-post-aside__card blog-post-aside__card--cta">
          <p class="eyebrow">Ready to book?</p>
          <h2 class="blog-post-aside__title">Get an itemised quote</h2>
          <p>Send the suburb, job type and plans or photos — we reply with a clear scope and price.</p>
          <p class="blog-post-aside__actions">
            <a class="btn btn--primary" href="/contact/#quote">Request a quote</a>
            <a class="btn btn--ghost" href="/blog/">All guides</a>
          </p>
        </div>
      </aside>
    </div>
  </article>

  <section class="section section--soft faq-section" aria-labelledby="faq-h">
    <div class="wrap">
      <div class="section-head faq-section__head">
        <p class="eyebrow">FAQ</p>
        <h2 id="faq-h">Questions from this guide</h2>
        <p>Short answers that sit with the article — ask us if yours is missing.</p>
      </div>
      <Faq faqs={d.faqs} columns={d.faqs.length >= 4 ? 2 : 1} />
      <div class="faq-section__foot">
        <p>Still deciding? Browse <a href="/services/">builders cleaning services</a> or the <a href="/faq/">full FAQ</a>.</p>
        <p class="faq-section__cta">
          <a class="btn btn--primary" href="/contact/#quote">Get a free quote</a>
          <a class="btn btn--ghost" href="/blog/">More guides</a>
        </p>
      </div>
    </div>
  </section>

  {moreGuides.length > 0 && (
    <section class="section blog-post-more" aria-labelledby="more-h">
      <div class="wrap">
        <div class="section-head blog-post-more__head">
          <p class="eyebrow">Keep reading</p>
          <h2 id="more-h">More builders clean guides</h2>
          <p>Other plain-English answers from the same Brisbane crew.</p>
        </div>
        <div class="blog-post-more__grid">
          {moreGuides.map((p) => (
            <a class="blog-page-card" href={`/blog/${p.id}/`}>
              <div class="blog-page-card__media">
                <Photo
                  photo={p.data.photo}
                  alt={p.data.photoAlt}
                  caption={false}
                  crop={[16, 10]}
                  class="blog-page-card__photo"
                  sizes="(min-width: 960px) 380px, (min-width: 640px) 50vw, 100vw"
                  widths={[360, 540, 720]}
                />
              </div>
              <div class="blog-page-card__body">
                <time class="blog-page-card__date" datetime={p.data.pubDate.toISOString().slice(0, 10)}>
                  {fmt(p.data.pubDate)}
                </time>
                <h3 class="blog-page-card__title">{p.data.h1}</h3>
                <p class="blog-page-card__summary">{p.data.summary}</p>
                <span class="blog-page-card__more" aria-hidden="true">Read the guide</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <CtaBand />
</BaseLayout>
