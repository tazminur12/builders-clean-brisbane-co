---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import CtaButtons from '../../components/CtaButtons.astro';
import Icon from '../../components/Icon.astro';
import TrustStrip from '../../components/TrustStrip.astro';
import StageDiagram from '../../components/StageDiagram.astro';
import Steps from '../../components/Steps.astro';
import Photo from '../../components/Photo.astro';
import Comparison from '../../components/Comparison.astro';
import AreaColumns from '../../components/AreaColumns.astro';
import Testimonials from '../../components/Testimonials.astro';
import Faq from '../../components/Faq.astro';
import CtaBand from '../../components/CtaBand.astro';
import { SERVICES, SERVICE_GROUPS, serviceBySlug, serviceUrl, type Service } from '../../data/services';
import { PHOTOS, type PhotoKey } from '../../data/photos';
import { rich, plain, quoteTime, priceText } from '../../lib/text';
import { serviceSchema, allAreasServed, breadcrumbList } from '../../lib/schema';

export const getStaticPaths = (() => SERVICES.map((s) => ({ params: { slug: s.slug } }))) satisfies GetStaticPaths;

const s: Service = serviceBySlug(Astro.params.slug as string);
const ctx = { price: s.priceFrom };
const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Services', href: '/services/' },
  { label: s.name, href: serviceUrl(s.slug) },
];

const hero = s.photos[0];
const used = new Set<PhotoKey>([hero.key]);
const gallery = s.photos.slice(1);
gallery.forEach((p) => used.add(p.key));
const fallbackOrder: PhotoKey[] = ['living-dining', 'kitchen', 'polished-concrete', 'bathroom-final', 'stairs', 'new-home'];
if (gallery.length === 0) {
  const k = fallbackOrder.find((x) => !used.has(x))!;
  gallery.push({ key: k, alt: PHOTOS[k].alt });
}
const related = s.related.map(serviceBySlug);
const groupLabel = SERVICE_GROUPS[s.group].label;
const priceFrom = priceText(s.priceFrom);

const schema = [
  breadcrumbList(crumbs),
  serviceSchema({ name: s.name, serviceType: s.name, url: serviceUrl(s.slug), description: plain(s.meta), areaServed: allAreasServed() }),
];
---
<BaseLayout title={s.title} description={plain(s.meta)} schema={schema} ogImage={PHOTOS[hero.key].src}>
  <PageHead
    crumbs={crumbs}
    h1={s.h1}
    eyebrow={groupLabel}
    photo={hero.key}
    photoAlt={hero.alt}
    meta={[
      `From ${priceFrom}`,
      `Quote within ${quoteTime()}`,
      'Supervisor check + photo report',
    ]}
  >
    <div class="answer">
      <p>{s.summary}</p>
    </div>
    <CtaButtons on="teal" showWhatsapp heroFallback class="mt-2" />
    <p class="page-head__upload">
      <Icon name="upload" />
      <span><a href="/contact/#quote">Upload plans or photos</a> for a faster quote.</span>
    </p>
  </PageHead>
  {hero.todo && <Fragment set:html={`<!-- TODO: real job photo of ${hero.todo} -->`} />}

  <TrustStrip />

  <section class="section section--soft svc-detail-intro" aria-labelledby="intro-h">
    <div class="wrap svc-detail-intro__inner">
      <p class="eyebrow">About this service</p>
      <h2 id="intro-h" class="sr-only">{s.name}</h2>
      <div class="answer svc-detail-intro__copy">
        <p set:html={rich(s.intro, ctx)} />
      </div>
    </div>
  </section>

  <section class="section builders-pains" aria-labelledby="pains-h">
    <div class="wrap">
      <div class="section-head builders-pains__head">
        <p class="eyebrow">Sound familiar?</p>
        <h2 id="pains-h">What we hear before a {s.short}</h2>
        <p set:html={rich(s.painsAnswer, ctx)} />
      </div>
      <ul class="pains">{s.pains.map((p) => <li>{p}</li>)}</ul>
    </div>
  </section>

  <section class="section section--mist area-scope" aria-labelledby="inc-h">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Scope</p>
        <h2 id="inc-h">{s.includedH2}</h2>
        <p>Your itemised quote lists every item below that applies to your job, room by room.</p>
      </div>
      <div class="checklist-grid">
        {s.included.map((g) => (
          <div class="check-group">
            <h3>{g.group}</h3>
            <ul class="ticks">{g.items.map((i) => <li set:html={rich(i, ctx)} />)}</ul>
          </div>
        ))}
      </div>
      {s.notIncluded && (
        <div class="not-included">
          <h3>Quoted separately</h3>
          <ul>{s.notIncluded.map((i) => <li set:html={rich(i, ctx)} />)}</ul>
        </div>
      )}
    </div>
  </section>

  {s.stage && (
    <section class="section stages-section" aria-labelledby="stage-h">
      <div class="wrap">
        <div class="section-head stages-section__head">
          <p class="eyebrow">Build stages</p>
          <h2 id="stage-h">
            {s.stage === 'all' ? 'Rough, final and handover: book one stage or all three' : 'Where this clean fits in the build'}
          </h2>
          <p>Most builds need more than one clean. See how this service sits in the program.</p>
        </div>
        <StageDiagram current={s.stage} />
      </div>
    </section>
  )}

  {s.sections.length > 0 && (
    <section class="section section--soft svc-detail-body" aria-label="More about this service">
      <div class="wrap svc-detail-body__grid">
        {s.sections.map((sec) => (
          <article class="svc-detail-body__card">
            <h2>{sec.h2}</h2>
            {sec.paras.map((p) => <p set:html={rich(p, ctx)} />)}
          </article>
        ))}
      </div>
    </section>
  )}

  <section class="section section--teal on-teal how-section" aria-labelledby="how-h">
    <div class="wrap">
      <div class="section-head how-section__head">
        <p class="eyebrow">How it works</p>
        <h2 id="how-h">Booking a {s.short} in five steps</h2>
        <p>From plans to sign-off — the same process on every job.</p>
      </div>
      <Steps />
    </div>
  </section>

  <section class="section work-section" aria-labelledby="photos-h">
    <div class="wrap">
      <div class="section-head work-section__head">
        <p class="eyebrow">Our work</p>
        <h2 id="photos-h">From our Brisbane jobs</h2>
        <p>Real finishes, real sites — no stock photos.</p>
      </div>
      <div class="work-gallery">
        {gallery.map((p) => (
          <div class="work-gallery__item">
            {p.todo && <Fragment set:html={`<!-- TODO: real job photo of ${p.todo} -->`} />}
            <Photo
              photo={p.key}
              alt={p.alt}
              caption={false}
              crop={[4, 3]}
              class="work-gallery__photo"
              sizes="(min-width: 960px) 380px, (min-width: 640px) 50vw, 100vw"
              widths={[360, 540, 720, 860]}
            />
          </div>
        ))}
        <div class="work-gallery__item">
          <Photo
            photo={hero.key}
            alt={hero.alt}
            caption={false}
            crop={[4, 3]}
            class="work-gallery__photo"
            sizes="(min-width: 960px) 380px, (min-width: 640px) 50vw, 100vw"
            widths={[360, 540, 720, 860]}
          />
        </div>
      </div>
      <p class="work-section__cta">
        <a class="btn btn--ghost" href="/our-work/">See more Brisbane job photos</a>
        <a class="btn btn--primary" href="/contact/#quote">Get a free quote</a>
      </p>
    </div>
  </section>

  <section class="section section--mist area-compare" aria-labelledby="cmp-h">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Compare</p>
        <h2 id="cmp-h">Our crew vs a cheap clean</h2>
        <p>The cheapest quote often leaves the dust in the cupboards and the stickers on the glass. Here is what you get from us.</p>
      </div>
      <Comparison />
    </div>
  </section>

  <section class="section svc-detail-related" aria-labelledby="rel-h">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Related</p>
        <h2 id="rel-h">Related builders cleaning services</h2>
        <p>
          Part of our full <a href="/">builders clean Brisbane</a> offering. See costs in the
          <a href="/builders-clean-cost-brisbane/">price guide</a>, or check scope on the
          <a href="/builders-clean-checklist/">builders clean checklist</a>.
        </p>
      </div>
      <div class="svc-detail-related__grid">
        {related.map((r) => (
          <a class="svc-card" href={serviceUrl(r.slug)}>
            <h3 class="svc-card__title">{r.name}</h3>
            <p class="svc-card__summary">{r.summary}</p>
            <span class="svc-card__more" aria-hidden="true">View service</span>
          </a>
        ))}
      </div>

      <div class="svc-detail-areas">
        <h2 id="areas-h">Areas we cover</h2>
        <p>We do {s.short}s across Greater Brisbane. Choose your area:</p>
        <AreaColumns />
      </div>
    </div>
  </section>

  <Testimonials filter={s.slug} />

  <section class="section section--soft faq-section" aria-labelledby="faq-h">
    <div class="wrap">
      <div class="section-head faq-section__head">
        <p class="eyebrow">FAQ</p>
        <h2 id="faq-h">{s.name} questions</h2>
        <p>Straight answers on scope, timing, access and price.</p>
      </div>
      <Faq faqs={s.faqs} price={s.priceFrom} columns={2} />
      <div class="faq-section__foot">
        <p set:html={rich(s.closing, ctx)} />
        <p class="faq-section__cta">
          <a class="btn btn--primary" href="/contact/#quote">Get a free quote</a>
          <a class="btn btn--ghost" href="/services/">All services</a>
        </p>
      </div>
    </div>
  </section>

  <CtaBand job={s.name} who={s.group === 'commercial' ? 'builder' : undefined} />
</BaseLayout>
