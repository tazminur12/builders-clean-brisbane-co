---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import CtaButtons from '../../components/CtaButtons.astro';
import TrustStrip from '../../components/TrustStrip.astro';
import ServiceCards from '../../components/ServiceCards.astro';
import StageDiagram from '../../components/StageDiagram.astro';
import CtaBand from '../../components/CtaBand.astro';
import { PHOTOS } from '../../data/photos';
import { SERVICES, SERVICE_GROUPS, serviceUrl, type ServiceGroup } from '../../data/services';
import { breadcrumbList } from '../../lib/schema';
import { abs, quoteTime } from '../../lib/text';

const crumbs = [{ label: 'Home', href: '/' }, { label: 'Services', href: '/services/' }];
const groups = Object.keys(SERVICE_GROUPS) as ServiceGroup[];
const list = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Builders cleaning services in Brisbane',
  itemListElement: SERVICES.map((s, i) => ({ '@type': 'ListItem', position: i + 1, name: s.name, url: abs(serviceUrl(s.slug)) })),
};
---
<BaseLayout
  title="Builders Cleaning Services Brisbane | Builders Clean Brisbane Co."
  description="Builders cleaning services in Brisbane: rough, final, handover and sparkle cleans, renovations, apartments, fit-outs and residue removal. Get an itemised quote."
  schema={[breadcrumbList(crumbs), list]}
  ogImage={PHOTOS['living-dining'].src}
>
  <PageHead
    crumbs={crumbs}
    h1="Builders Cleaning Services in Brisbane"
    eyebrow={`${SERVICES.length} services`}
    photo="living-dining"
    photoAlt="Living and dining area after a builders clean in Brisbane"
    meta={[
      'Rough, final, handover and sparkle',
      `Itemised quotes within ${quoteTime()}`,
      'Supervisor check and photo report',
    ]}
  >
    <div class="answer">
      <p>
        Rough, final, handover and sparkle cleans — plus renovations, apartments, fit-outs and residue work — quoted room by room and booked to
        your program.
      </p>
    </div>
    <CtaButtons on="teal" showWhatsapp heroFallback class="mt-2" />
  </PageHead>
  <TrustStrip />

  <section class="section section--mist stages-section" aria-labelledby="stages-h">
    <div class="wrap">
      <div class="section-head stages-section__head">
        <p class="eyebrow">Start here</p>
        <h2 id="stages-h">Builders cleaning by stage</h2>
        <p>
          Most builds need more than one clean. The
          <a href="/services/post-construction-cleaning-brisbane/">post construction cleaning</a>
          page shows how rough, final and handover cleans fit together.
        </p>
      </div>
      <StageDiagram />
    </div>
  </section>

  <section class="section svc-section services-catalog" id="all-services" aria-labelledby="all-h">
    <div class="wrap">
      <div class="section-head svc-section__head">
        <p class="eyebrow">Full catalogue</p>
        <h2 id="all-h">Every builders clean, grouped by what you need</h2>
        <p>
          Seventeen services across build stages, property types, residue work and commercial sites. Open a service for scope, inclusions and pricing.
        </p>
      </div>

      <nav class="svc-jump" aria-label="Jump to a service group">
        {groups.map((g) => (
          <a class="svc-jump__link" href={`#svc-group-${g}`}>
            <span class="svc-jump__label">{SERVICE_GROUPS[g].label}</span>
            <span class="svc-jump__count">{SERVICES.filter((s) => s.group === g).length}</span>
          </a>
        ))}
      </nav>

      <ServiceCards headingLevel="h2" />
    </div>
  </section>

  <section class="section section--soft services-help" aria-labelledby="help-h">
    <div class="wrap">
      <div class="section-head services-help__head">
        <p class="eyebrow">Need a hand?</p>
        <h2 id="help-h">Not sure which clean — or what it should cost?</h2>
        <p>Send the stage and what you can see. We recommend the right service in the quote and price it room by room.</p>
      </div>

      <div class="services-help__grid">
        <article class="services-help__card">
          <p class="services-help__n" aria-hidden="true">01</p>
          <h3>Not sure which clean you need?</h3>
          <p>
            Tell us what stage the build is at and what you can see: dust, stickers, haze, paint, or a home that just needs to be ready for the keys.
            We will recommend the right service and explain why in the quote.
          </p>
          <p class="services-help__links">
            <a href="/builders-clean-checklist/">Builders clean checklist</a>
            <a href="/blog/rough-clean-vs-final-clean-vs-sparkle-clean/">Rough vs final vs sparkle</a>
          </p>
        </article>
        <article class="services-help__card">
          <p class="services-help__n" aria-hidden="true">02</p>
          <h3>What does it cost?</h3>
          <p>
            Every service is quoted on floor area, levels, glazing, finishes, access and build stage. The price guide shows how we work the numbers;
            the quote form gives you an exact, itemised price.
          </p>
          <p class="services-help__links">
            <a href="/builders-clean-cost-brisbane/">Builders clean price guide</a>
            <a href="/contact/#quote">Get an itemised quote</a>
          </p>
        </article>
      </div>

      <p class="services-help__cta">
        <a class="btn btn--primary" href="/contact/#quote">Get a free quote</a>
        <a class="btn btn--ghost" href="/for-builders/">Builder accounts</a>
      </p>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
