---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { FAQ_HUB } from '../data/faqs';
import { breadcrumbList, faqPage } from '../lib/schema';

const crumbs = [{ label: 'Home', href: '/' }, { label: 'FAQ', href: '/faq/' }];
const all = FAQ_HUB.flatMap((g) => g.faqs);
---
<BaseLayout
  title="Builders Clean FAQ Brisbane | Builders Clean Brisbane Co."
  description="Builders clean questions answered: how long a builders clean takes, what is included, who pays, access, insurance and residue. Brisbane answers. Get a quote."
  schema={[breadcrumbList(crumbs), faqPage(all)]}
>
  <PageHead crumbs={crumbs} h1="Builders Clean Questions Answered" eyebrow="FAQ">
    <div class="answer">
      <p>
        How long does a builders clean take? For most single homes in Brisbane, one day on site; larger homes and heavy residue take longer.
        Builders Clean Brisbane Co. is a Brisbane builders cleaning company, and these are the questions builders and homeowners ask us most,
        grouped by topic. Can’t find yours? <a href="/contact/" style="color:var(--c-lime)">Ask us</a>.
      </p>
    </div>
    <nav aria-label="FAQ topics" class="mt-2">
      <ul class="chips">{FAQ_HUB.map((g) => <li><a href={`#${g.id}`}>{g.group}</a></li>)}</ul>
    </nav>
  </PageHead>
  <section class="section">
    <div class="wrap wrap--narrow">
      {FAQ_HUB.map((g) => (
        <div class="mb-3" id={g.id}>
          <h2>{g.group}</h2>
          <Faq faqs={g.faqs} schema={false} />
        </div>
      ))}
      <p class="lead">Ready to book? See our <a href="/services/">builders cleaning services</a>, the <a href="/builders-clean-cost-brisbane/">price guide</a>, or <a href="/">builders clean Brisbane</a>.</p>
    </div>
  </section>
  <CtaBand />
</BaseLayout>
