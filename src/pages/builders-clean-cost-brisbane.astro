---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import CtaButtons from '../components/CtaButtons.astro';
import TrustStrip from '../components/TrustStrip.astro';
import Comparison from '../components/Comparison.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { PRICE_TABLE, PRICE_PER_M2, PRICE_FROM, PRICE_TO } from '../data/pricing';
import { PRICE_FAQS } from '../data/faqs';
import { PHOTOS } from '../data/photos';
import { breadcrumbList } from '../lib/schema';
import { priceText, quoteTime, recleanTime, rich } from '../lib/text';

const crumbs = [{ label: 'Home', href: '/' }, { label: 'Price guide', href: '/builders-clean-cost-brisbane/' }];
const from = priceText(PRICE_FROM, '[PRICE FROM]');
const to = priceText(PRICE_TO, '[PRICE TO]');
const p = (v: string) => priceText(v, '[PRICE]');
const perM2 = priceText(PRICE_PER_M2, '[PRICE PER M²]');
const faqs = PRICE_FAQS.map((f) => ({ ...f, a: f.a.replaceAll('[PRICE FROM]', from).replaceAll('[PRICE TO]', to) }));

const factors = [
  ['Floor area', 'The biggest driver. We quote from the plans, so a 180 m² single-storey home and a 320 m² two-storey home are priced on what is actually there.'],
  ['Number of levels', 'Stairs, balustrades, landings and a second set of bathrooms add time on every level.'],
  ['Bathrooms and kitchens', 'Wet areas take the longest: tiles, grout, glass, tapware and cabinetry. A home with four bathrooms costs more than one with two.'],
  ['Glazing and window count', 'Floor-to-ceiling glass, stacking doors and window tracks full of plaster dust are slow, careful work.'],
  ['Stone and polished concrete', 'Engineered stone, natural stone and polished concrete need pH-suitable products and more time to avoid etching.'],
  ['Access', 'Lift bookings, loading docks, carparks and long carries in apartment buildings add time before the clean even starts.'],
  ['Build stage and residue', 'A final clean on a tidy site is quicker than one on a site that skipped the rough clean. Heavy cement haze or paint overspray is quoted as residue removal.'],
  ['After hours or weekends', 'Overnight fit-out cleans and weekend work to meet a program may carry a different rate.'],
  ['Travel', 'Smaller jobs in outer suburbs may carry a travel charge, shown as its own line in the quote.'],
];

const saveTips = [
  ['Book a rough clean between trades', 'A final clean on a site that had a rough clean is faster — the crew is not shifting heavy dust before the detail work starts.'],
  ['Book after the last trade, not before', 'If the electrician or painter returns after the clean, you pay to have parts of it done again.'],
  ['Send plans and photos', 'An accurate scope means an accurate price, with no allowance for surprises built in.'],
  ['Make sure power and water are on', 'A crew waiting for a connection is a crew on the clock.'],
  ['Group the work', 'Builders with several homes or units on the same program get a better rate than one-off bookings.'],
];

const stages = [
  {
    title: 'Rough clean',
    text: 'Debris and packaging to the skip area, plaster dust swept and vacuumed, floors clear for the next trade.',
    href: '/services/builders-rough-clean-brisbane/',
    label: 'Rough clean details',
  },
  {
    title: 'Final builders clean',
    text: 'Every interior surface top to bottom, inside cupboards and drawers, glass, wet areas and floors, supervisor check and photo report.',
    href: '/services/builders-final-clean-brisbane/',
    label: 'Final clean details',
  },
  {
    title: 'Handover clean',
    text: 'A final clean timed to the inspection, with a pre-handover walk, a second supervisor check and a before-and-after report.',
    href: '/services/builders-handover-clean-brisbane/',
    label: 'Handover clean details',
  },
  {
    title: 'Sparkle clean',
    text: 'The final clean plus detail: tracks, hinges, cupboard interiors, streak-free glass and a last floor buff.',
    href: '/services/sparkle-clean-brisbane/',
    label: 'Sparkle clean details',
  },
];
---
<BaseLayout
  title="Builders Clean Cost Brisbane | Builders Clean Brisbane Co."
  description="How much does a builders clean cost in Brisbane? Price ranges by property size and stage, what changes the price, and how to get an itemised quote today."
  schema={[breadcrumbList(crumbs)]}
  ogImage={PHOTOS['kitchen'].src}
>
  <PageHead
    crumbs={crumbs}
    h1="Builders Clean Cost in Brisbane"
    eyebrow="Price guide 2026"
    photo="kitchen"
    photoAlt="Kitchen after a final builders clean in Brisbane, priced by floor area and finishes"
    meta={[
      `Typical home: ${from}–${to}`,
      `Itemised quote within ${quoteTime()}`,
      'Priced from plans or photos',
    ]}
  >
    <div class="answer">
      <p>
        A typical three to four bedroom builders clean in Brisbane runs {from} to {to}. Exact price depends on floor area, levels, finishes,
        access and stage.
      </p>
    </div>
    <CtaButtons on="teal" showWhatsapp heroFallback class="mt-2" quoteLabel="Get an exact price" />
  </PageHead>
  <TrustStrip />

  <section class="section cost-table-section" aria-labelledby="table-h">
    <div class="wrap">
      <div class="section-head cost-table-section__head">
        <p class="eyebrow">Price list</p>
        <h2 id="table-h">Starting prices by size and stage</h2>
        <p>Starting prices for a standard job in Brisbane. Your itemised quote confirms the exact price from plans or photos.</p>
      </div>

      <div class="table-wrap table-wrap--price" role="region" aria-label="Builders clean price table" tabindex="0">
        <table class="price-table">
          <caption class="sr-only">Builders clean starting prices in Brisbane by property type and cleaning stage</caption>
          <thead>
            <tr>
              <th scope="col">Property</th>
              <th scope="col">Rough clean</th>
              <th scope="col">Final builders clean</th>
              <th scope="col">Handover clean</th>
              <th scope="col">Sparkle clean</th>
            </tr>
          </thead>
          <tbody>
            {PRICE_TABLE.map((r) => (
              <tr>
                <th scope="row">{r.property}</th>
                <td>{p(r.rough)}</td>
                <td>{r.final === '—' ? '—' : p(r.final)}</td>
                <td>{r.handover === '—' ? '—' : p(r.handover)}</td>
                <td>{r.sparkle === '—' ? '—' : p(r.sparkle)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="cost-note">
        Prices include GST unless stated. Specialist work (residue removal, pressure washing, carpet steam cleaning, high-level windows) is quoted separately.
      </p>

      <div class="cost-quick">
        <article class="cost-quick__card">
          <p class="cost-quick__n" aria-hidden="true">01</p>
          <h3>Cost per square metre</h3>
          <p>
            For commercial fit-outs and large or unusual homes we price per square metre: <strong>{perM2}</strong>. The rate moves with glazing,
            finishes and after-hours work. For most homes, the per-property prices above are the simpler guide.
          </p>
        </article>
        <article class="cost-quick__card">
          <p class="cost-quick__n" aria-hidden="true">02</p>
          <h3>4 bedroom house?</h3>
          <p>
            A typical four bedroom, two bathroom single-storey home sits in the “House, 3–4 bed” row. Add time for a second level, a third bathroom,
            a lot of glass or a stone-heavy kitchen. Send the plans and we will tell you exactly.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="section section--mist price-section" aria-labelledby="factors-h">
    <div class="wrap">
      <div class="section-head price-section__head">
        <p class="eyebrow">What changes the price</p>
        <h2 id="factors-h">Nine things that change a builders clean quote</h2>
        <p>These are the questions we ask before we price a job. Answer them in the quote form and your price will be more accurate.</p>
      </div>
      <dl class="price-factors">
        {factors.map(([k, v], i) => (
          <div class="price-factor">
            <dt>
              <span class="price-factor__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span class="price-factor__title">{k}</span>
            </dt>
            <dd class="price-factor__text">{v}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section services-help cost-advice" aria-labelledby="save-h">
    <div class="wrap">
      <div class="section-head services-help__head">
        <p class="eyebrow">Spend less, get more</p>
        <h2 id="save-h">Keep the cost down — and spot a weak quote</h2>
        <p>Five practical ways to save, plus the three questions that expose a cheap builders clean that costs more later.</p>
      </div>

      <div class="cost-advice__grid">
        <article class="cost-advice__card">
          <h3>Five ways to keep cost down</h3>
          <ol class="cost-advice__steps">
            {saveTips.map(([title, text], i) => (
              <li>
                <span class="cost-advice__step-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <span><strong>{title}.</strong> {text}</span>
              </li>
            ))}
          </ol>
        </article>
        <article class="cost-advice__card">
          <h3>Cheap builders clean: what to watch for</h3>
          <p>
            Marketplace listings often look cheap because they are priced by the hour or a vague scope. Before you accept a low quote, ask:
          </p>
          <ul class="cost-advice__checks">
            <li>Which rooms and surfaces are included — including inside cupboards and drawers?</li>
            <li>How many hours, and how many people, are in the price?</li>
            <li>What happens if something is missed, or the clean runs long?</li>
          </ul>
          <p class="cost-advice__aside">
            If the answers are vague, the price is too. Read
            <a href="/blog/builders-clean-vs-bond-clean-vs-regular-clean/">builders clean vs bond clean</a>
            for why the two are priced differently.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="section section--soft cost-value" aria-labelledby="inc-h">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Value, not the cheapest</p>
        <h2 id="inc-h">What’s included at each price</h2>
        <p>
          A cheap builders clean can look good on paper and cost more in the end: a second clean, a defect on the handover list, or a scratched
          pane of glass. Compare what you get, not just the number.
        </p>
      </div>
      <Comparison />
      <div class="cost-stages">
        {stages.map((s) => (
          <article class="cost-stage">
            <h3>{s.title}</h3>
            <p>{s.text}</p>
            <a class="cost-stage__more" href={s.href}>{s.label}</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section cost-policy" aria-labelledby="policy-h">
    <div class="wrap cost-policy__grid">
      <article class="cost-policy__card">
        <p class="eyebrow">Pricing policy</p>
        <h2 id="policy-h">How we quote</h2>
        <ul class="ticks">
          <li>Itemised quote within {quoteTime()}, room by room</li>
          <li>No hidden fees: travel, after-hours and add-ons are listed as their own lines</li>
          <li>Variations only if the scope changes, agreed with you in writing first</li>
          <li>Missed in-scope items re-cleaned if reported within {recleanTime()}</li>
        </ul>
        <p class="cost-note cost-note--tight" set:html={rich('Policy details to be confirmed by the owner before launch.{{?pricing-policy}}')} />
      </article>
      <article class="cost-policy__card">
        <p class="eyebrow">Who books us</p>
        <h3>Builder accounts</h3>
        <p>
          Builders with regular work, estate programs or multi-dwelling projects can get account pricing based on volume and stages.
          See <a href="/for-builders/">construction cleaning for builders</a>.
        </p>
        <h3>Homeowners</h3>
        <p>
          Usually one clean: a <a href="/services/new-home-builders-clean-brisbane/">new home clean</a> after handover, or a
          <a href="/services/renovation-cleaning-brisbane/">post renovation clean</a>. Both are priced from plans or photos. Read the
          <a href="/blog/builders-clean-cost-brisbane-2026-price-guide/">2026 price guide article</a> for worked examples.
        </p>
      </article>
    </div>
  </section>

  <section class="section section--mist faq-section" aria-labelledby="faq-h">
    <div class="wrap">
      <div class="section-head faq-section__head">
        <p class="eyebrow">FAQ</p>
        <h2 id="faq-h">Builders clean cost questions</h2>
        <p>Ranges, fixed prices, travel and how to get an accurate quote.</p>
      </div>
      <Faq faqs={faqs} columns={2} />
      <div class="faq-section__foot">
        <p>The fastest way to know your builders clean cost in Brisbane is to send the plans. Itemised quote within {quoteTime()}.</p>
        <p class="faq-section__cta">
          <a class="btn btn--primary" href="/contact/#quote">Get an exact price</a>
          <a class="btn btn--ghost" href="/services/">Browse services</a>
        </p>
      </div>
    </div>
  </section>

  <CtaBand heading="Send plans for an itemised quote." />
</BaseLayout>
