---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import CtaButtons from '../../components/CtaButtons.astro';
import TrustStrip from '../../components/TrustStrip.astro';
import Faq from '../../components/Faq.astro';
import CtaBand from '../../components/CtaBand.astro';
import { REGIONS, SUBURBS, AREA_FAQ_BANK, areaUrl } from '../../data/areas';
import { AREAS_HUB_FAQ } from '../../data/faqs';
import { PHOTOS } from '../../data/photos';
import { breadcrumbList } from '../../lib/schema';
import { quoteTime } from '../../lib/text';

const crumbs = [{ label: 'Home', href: '/' }, { label: 'Areas', href: '/areas/' }];

/** Eight FAQs — four per column on desktop. */
const areasFaqs = [AREAS_HUB_FAQ, ...AREA_FAQ_BANK];

const growthLinks = [
  { slug: 'north-lakes', name: 'North Lakes' },
  { slug: 'narangba', name: 'Narangba' },
  { slug: 'caboolture', name: 'Caboolture' },
  { slug: 'springfield', name: 'Springfield' },
  { slug: 'ripley', name: 'Ripley' },
  { slug: 'yarrabilba', name: 'Yarrabilba' },
  { slug: 'park-ridge', name: 'Park Ridge' },
  { slug: 'flagstone', name: 'Flagstone' },
];
---
<BaseLayout
  title="Builders Clean Areas Brisbane | Builders Clean Brisbane Co."
  description="Builders clean and post construction cleaning across Brisbane, Moreton Bay, Logan, Ipswich and the Redlands. Find your suburb and request an itemised quote."
  schema={[breadcrumbList(crumbs)]}
  ogImage={PHOTOS['new-home'].src}
>
  <PageHead
    crumbs={crumbs}
    h1="Builders Clean Service Areas Across Brisbane"
    eyebrow="Where we work"
    photo="new-home"
    photoAlt="New home ready after a builders clean in Greater Brisbane"
    meta={[
      'Five regions across Greater Brisbane',
      `Quotes within ${quoteTime()}`,
      'Travel shown before you book',
    ]}
  >
    <div class="answer">
      <p>
        Builders cleans across Brisbane City, Moreton Bay, Logan, Ipswich and the Redlands — from inner-city apartments to the growth corridors.
      </p>
    </div>
    <CtaButtons on="teal" showWhatsapp heroFallback class="mt-2" />
  </PageHead>
  <TrustStrip />

  <section class="section section--mist areas-cover" aria-labelledby="cover-h">
    <div class="wrap">
      <div class="section-head areas-cover__head">
        <p class="eyebrow">Service area</p>
        <h2 id="cover-h">Five regions across Greater Brisbane</h2>
        <p>
          We come to the job — no shopfront to visit. Crews work from the inner city to the northern, southern and western growth corridors.
          Not sure we cover your suburb? Send it with the job and we will confirm.
        </p>
      </div>
      <nav class="areas-jump" aria-label="Jump to a region">
        {REGIONS.map((r) => {
          const count = SUBURBS.filter((s) => s.region === r.slug).length;
          return (
            <a class="areas-jump__link" href={`#region-${r.slug}`}>
              <span class="areas-jump__label">{r.name}</span>
              <span class="areas-jump__count">{count > 0 ? count : 'Ask'}</span>
            </a>
          );
        })}
      </nav>
    </div>
  </section>

  <section class="section areas-section" aria-labelledby="regions-h">
    <div class="wrap">
      <div class="section-head areas-section__head">
        <p class="eyebrow">Regions</p>
        <h2 id="regions-h">Find your suburb</h2>
        <p>Open a region for local detail, or jump straight to a suburb page below.</p>
      </div>
      <div class="areas-grid areas-grid--hub">
        {REGIONS.map((r) => {
          const suburbs = SUBURBS.filter((s) => s.region === r.slug);
          return (
            <article class="area-card" id={`region-${r.slug}`}>
              <h3 class="area-card__title"><a href={areaUrl(r.slug)}>{r.name}</a></h3>
              <p class="area-card__blurb">{r.blurb}</p>
              {suburbs.length > 0 && (
                <ul class="area-card__subs">
                  {suburbs.map((s) => (
                    <li><a href={areaUrl(s.slug)}>{s.name}</a></li>
                  ))}
                </ul>
              )}
              {r.slug === 'redland' && suburbs.length === 0 && (
                <p class="area-card__note">Redlands suburbs: ask when you book</p>
              )}
              <a class="area-card__more" href={areaUrl(r.slug)}>View {r.name}</a>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section section--soft areas-growth" aria-labelledby="growth-h">
    <div class="wrap areas-growth__grid">
      <div class="areas-growth__copy">
        <p class="eyebrow">Growth corridors</p>
        <h2 id="growth-h">Where most new homes are handing over</h2>
        <p>
          Master-planned estates to the north, south and west drive a lot of our work. Estate builders can send a lot list and handover dates —
          we plan the cleans in sequence.
        </p>
        <p class="areas-growth__cta">
          <a class="btn btn--primary" href="/contact/#quote">Get a free quote</a>
          <a class="btn btn--ghost" href="/for-builders/">Builder accounts</a>
        </p>
      </div>
      <ul class="areas-growth__list">
        {growthLinks.map((g) => (
          <li><a href={areaUrl(g.slug)}>{g.name}</a></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section faq-section" aria-labelledby="faq-h">
    <div class="wrap">
      <div class="section-head faq-section__head">
        <p class="eyebrow">FAQ</p>
        <h2 id="faq-h">Service area questions</h2>
        <p>Travel, coverage, quotes and what happens if something is missed.</p>
      </div>
      <Faq faqs={areasFaqs} columns={2} />
      <div class="faq-section__foot">
        <p>More answers in the <a href="/faq/">builders clean FAQ</a>.</p>
        <p class="faq-section__cta">
          <a class="btn btn--primary" href="/contact/#quote">Get a free quote</a>
          <a class="btn btn--ghost" href="/faq/">All FAQ answers</a>
        </p>
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
