---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import CtaButtons from '../components/CtaButtons.astro';
import CtaBand from '../components/CtaBand.astro';
import { SITE, hasEmail } from '../config/site';
import { PHOTOS } from '../data/photos';
import { breadcrumbList } from '../lib/schema';

const crumbs = [{ label: 'Home', href: '/' }, { label: 'Privacy policy', href: '/privacy-policy/' }];

const sections = [
  {
    id: 'collect',
    title: 'What we collect',
    body: 'We collect only what you send us through the quote form, the checklist download form, by phone or by email: your name, contact details, the job address or suburb, dates, notes and any plans or photos you upload.',
  },
  {
    id: 'use',
    title: 'How we use it',
    body: 'We use your details to quote, book and complete your clean, to send your photo report, and to follow up on that job. We do not sell your information or add you to a mailing list.',
  },
  {
    id: 'storage',
    title: 'Where it is stored',
    body: 'Our website is hosted by Netlify, and form submissions (including uploaded files) are stored by Netlify Forms. We may keep job records, including photo reports, for our business records.',
  },
  {
    id: 'cookies',
    title: 'Cookies and tracking',
    body: 'This website does not set advertising cookies. If you choose to load the Google Map, Google may set its own cookies under Google’s privacy policy.',
  },
];

const nextLinks = [
  {
    href: '/terms/',
    title: 'Terms',
    text: 'Quotes, scope, variations, access and re-cleans.',
  },
  {
    href: '/contact/',
    title: 'Contact',
    text: 'Ask a question or request a builders clean quote.',
  },
  {
    href: '/',
    title: 'Home',
    text: 'Back to Builders Clean Brisbane Co.',
  },
];
---
<BaseLayout
  title="Privacy Policy | Builders Clean Brisbane Co."
  description="How Builders Clean Brisbane Co. collects, uses and stores the details you send through our quote form or by phone, and how to ask us to update or delete them."
  schema={[breadcrumbList(crumbs)]}
  ogImage={PHOTOS['living-dining'].src}
>
  <PageHead
    crumbs={crumbs}
    h1="Privacy policy"
    eyebrow="Legal"
    photo="living-dining"
    photoAlt="Living and dining room after a post-construction clean in Brisbane"
    meta={[
      'No mailing list',
      'No ad cookies',
      'Updated Nov 2026',
    ]}
  >
    <div class="answer">
      <p>
        How {SITE.name} collects, uses and stores the details you send us — and how to ask for a correction or deletion.
      </p>
    </div>
    <CtaButtons on="teal" heroFallback class="mt-2" />
  </PageHead>

  <section class="section section--soft legal-page-intro" aria-labelledby="intro-h">
    <div class="wrap legal-page-intro__inner">
      <p class="eyebrow">Overview</p>
      <h2 id="intro-h" class="sr-only">Overview</h2>
      <p class="legal-page-intro__lead">
        This policy explains how {SITE.name} ({SITE.legalName}) handles personal information. Last updated: November 2026.
      </p>
      <nav aria-label="Privacy topics">
        <ul class="legal-page-jump">
          {sections.map((s) => (
            <li><a class="legal-page-jump__chip" href={`#${s.id}`}>{s.title}</a></li>
          ))}
          <li><a class="legal-page-jump__chip" href="#access">Access and correction</a></li>
        </ul>
      </nav>
    </div>
  </section>

  <section class="section legal-page-body">
    <div class="wrap legal-page-body__layout">
      <div class="legal-page-body__main">
        {sections.map((s, i) => (
          <article class="legal-page-block" id={s.id}>
            <p class="legal-page-block__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</p>
            <h2>{s.title}</h2>
            <p>{s.body}</p>
          </article>
        ))}

        <article class="legal-page-block" id="access">
          <p class="legal-page-block__n" aria-hidden="true">05</p>
          <h2>Access and correction</h2>
          <p>
            You can ask to see, correct or delete the personal information we hold about you
            {hasEmail ? (
              <> by emailing <a href={`mailto:${SITE.email}`}>{SITE.email}</a></>
            ) : (
              <> through our <a href="/contact/">contact form</a></>
            )}.
          </p>
        </article>
      </div>

      <aside class="legal-page-aside" aria-label="Related">
        <div class="legal-page-aside__card">
          <p class="eyebrow">Questions</p>
          <h2 class="legal-page-aside__title">Need a change?</h2>
          <p>
            Email or use the contact form to request access, a correction or deletion of your details.
          </p>
          <p class="legal-page-aside__actions">
            <a class="btn btn--primary" href="/contact/">Contact us</a>
            <a class="btn btn--ghost" href="/terms/">View terms</a>
          </p>
        </div>
        <div class="legal-page-aside__card">
          <p class="eyebrow">Also see</p>
          <ul class="legal-page-aside__links">
            <li><a href="/terms/">Terms of use</a></li>
            <li><a href="/contact/">Get a quote</a></li>
            <li><a href="/builders-clean-checklist/">Checklist</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </section>

  <section class="section section--mist legal-page-next" aria-labelledby="next-h">
    <div class="wrap">
      <div class="section-head legal-page-next__head">
        <p class="eyebrow">Next</p>
        <h2 id="next-h">Related pages</h2>
        <p>Terms for quotes and bookings, or get in touch.</p>
      </div>
      <div class="legal-page-next__grid">
        {nextLinks.map((l) => (
          <a class="svc-card" href={l.href}>
            <h3 class="svc-card__title">{l.title}</h3>
            <p class="svc-card__summary">{l.text}</p>
            <span class="svc-card__more" aria-hidden="true">Open</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
