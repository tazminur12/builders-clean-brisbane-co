---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import Photo from '../components/Photo.astro';
import TrustStrip from '../components/TrustStrip.astro';
import CtaBand from '../components/CtaBand.astro';
import { SITE, isSet } from '../config/site';
import { PHOTOS } from '../data/photos';
import { breadcrumbList } from '../lib/schema';
import { quoteTime, recleanTime, insuranceText, rich } from '../lib/text';

const crumbs = [{ label: 'Home', href: '/' }, { label: 'About', href: '/about/' }];
const owner = isSet(SITE.ownerName) ? SITE.ownerName : '[OWNER / SUPERVISOR NAME — TBC]';
---
<BaseLayout
  title="About Builders Clean Brisbane Co. | Brisbane Builders Cleaners"
  description="About Builders Clean Brisbane Co., the Brisbane builders clean company that only does builders and post construction cleaning. Our standards and how we work."
  schema={[breadcrumbList(crumbs)]}
  ogImage={PHOTOS['stairs'].src}
>
  <PageHead crumbs={crumbs} h1="About Builders Clean Brisbane Co." eyebrow="Brisbane builders cleaners" photo="stairs" photoAlt="Timber stairs cleaned by the Builders Clean Brisbane Co. crew after construction">
    <div class="answer">
      <p>
        Builders Clean Brisbane Co. is a Brisbane builders clean company that only does builders and post construction cleaning, for builders
        and homeowners across Brisbane, Moreton Bay, Logan, Ipswich and the Redlands. Our promise is simple: on the handover date, to handover
        standard, with photos to prove it.
      </p>
    </div>
  </PageHead>
  <TrustStrip />

  <section class="section" aria-labelledby="story-h">
    <div class="wrap split">
      <div class="stack">
        <h2 id="story-h">Our story</h2>
        <p>[FOUNDING YEAR / STORY — TBC]</p>
        <!-- TODO: owner or supervisor photo and short story (real photo only). -->
        <p><strong>Who you will deal with:</strong> {owner}</p>
        <h2 class="mt-3">Why we only do builders cleans</h2>
        <p>
          A builders clean is a different job from a house clean or a bond clean. Fine plaster dust settles inside every cupboard, cement haze
          clings to new tiles, and stone, glass and polished concrete mark easily if the wrong product touches them. Doing one kind of clean,
          every day, is how we get it right.
        </p>
        <p>
          We also saw a gap. Most builders cleaning companies talk only to builders, and homeowners are an afterthought. We clean for both, in
          plain language, with a quote that says exactly what is included.
        </p>
      </div>
      <Photo photo="pantry" />
    </div>
  </section>

  <section class="section section--mist" aria-labelledby="trades-h">
    <div class="wrap split">
      <div>
        <h2 id="trades-h">How we work with trades</h2>
        <p>
          We clean after the plasterer and before the painter, after the last trade and before the inspection. We book into the builder’s
          program, keep out of the way of trades still on site, and move with the program when it changes. Builders get one contact who answers
          the phone. See <a href="/for-builders/">our page for builders</a>.
        </p>
      </div>
      <div>
        <h2>Our standards</h2>
        <ul class="ticks">
          <li>A written, room-by-room checklist on every job</li>
          <li>Itemised quotes within {quoteTime()}</li>
          <li>A supervisor walk before sign-off</li>
          <li>A before-and-after photo report</li>
          <li>In-scope items re-cleaned if reported within {recleanTime()}</li>
          <li>Surface-safe products for stone, glass, stainless and polished concrete</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="cred-h">
    <div class="wrap wrap--narrow">
      <h2 id="cred-h">Credentials</h2>
      <p set:html={rich(`Public liability insurance: ${insuranceText()}. White cards, police checks and SWMS on request.{{?credentials}}`)} />
      <p>We only list credentials we hold. If your site needs something specific, ask and we will tell you straight.</p>
      <h2 class="mt-3">Brisbane based</h2>
      <p>
        We are a Brisbane business working across Greater Brisbane. Our photos are from our own Brisbane jobs, our crews know Brisbane’s
        humidity and storm season, and our service areas run from the inner city to the growth estates. See the <a href="/areas/">areas we cover</a>,
        our <a href="/our-work/">work</a> and our <a href="/services/">builders cleaning services</a>, or start from <a href="/">builders clean Brisbane</a>.
      </p>
    </div>
  </section>
  <CtaBand />
</BaseLayout>
