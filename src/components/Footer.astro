---
import { SITE, hasPhone, hasEmail, hasHours, hasWhatsapp, telHref, whatsappHref, isSet } from '../config/site';
import { SERVICES, serviceUrl } from '../data/services';
import { REGIONS, SUBURBS, areaUrl } from '../data/areas';

const year = new Date().getFullYear();
const socials = Object.entries(SITE.socials).filter(([, v]) => isSet(v));
---
<footer class="site-footer on-teal">
  <div class="wrap">
    <div class="site-footer__grid">
      <div>
        <img src="/brand/logo-stacked-reversed.svg" alt="" width="333" height="290" loading="lazy" style="width:150px;margin-bottom:18px" />
        <address class="nap">
          <strong>{SITE.name}</strong>
          <span>{SITE.addressLocality}, {SITE.addressRegion}</span>
          <span>Builders cleaning across Brisbane, Moreton Bay, Logan, Ipswich and the Redlands</span>
          {hasHours && <span>Hours: {SITE.hours}</span>}
          {hasPhone && <a href={telHref}>{SITE.phoneDisplay}</a>}
          {hasEmail && <a href={`mailto:${SITE.email}`}>{SITE.email}</a>}
          {hasWhatsapp && <a href={whatsappHref} rel="noopener">WhatsApp us</a>}
        </address>
        <p><a class="btn btn--lime" href="/contact/#quote">Get a free quote</a></p>
        {isSet(SITE.gbpUrl) && <p><a href={SITE.gbpUrl} rel="noopener">Find us on Google</a></p>}
        {socials.length > 0 && (
          <ul aria-label="Social media">
            {socials.map(([k, v]) => <li><a href={v} rel="noopener">{k.charAt(0).toUpperCase() + k.slice(1)}</a></li>)}
          </ul>
        )}
      </div>
      <nav aria-label="Services">
        <h2>Services</h2>
        <ul class="site-footer__cols">
          {SERVICES.map((s) => <li><a href={serviceUrl(s.slug)}>{s.name}</a></li>)}
        </ul>
      </nav>
      <nav aria-label="Service areas">
        <h2>Service areas</h2>
        <ul class="site-footer__cols">
          {REGIONS.map((r) => <li><a href={areaUrl(r.slug)}>{r.name}</a></li>)}
          {SUBURBS.map((s) => <li><a href={areaUrl(s.slug)}>{s.name}</a></li>)}
        </ul>
      </nav>
      <nav aria-label="Company">
        <h2>Company</h2>
        <ul>
          <li><a href="/">Builders clean Brisbane</a></li>
          <li><a href="/builders-clean-cost-brisbane/">Price guide</a></li>
          <li><a href="/builders-clean-checklist/">Checklist</a></li>
          <li><a href="/for-builders/">For builders</a></li>
          <li><a href="/our-work/">Our work</a></li>
          <li><a href="/reviews/">Reviews</a></li>
          <li><a href="/about/">About</a></li>
          <li><a href="/faq/">FAQ</a></li>
          <li><a href="/blog/">Guides</a></li>
          <li><a href="/contact/">Contact</a></li>
        </ul>
      </nav>
    </div>
    <div class="site-footer__bottom">
      <span>&copy; {year} {SITE.name}{isSet(SITE.legalName) ? ` · ${SITE.legalName}` : ''}</span>
      <span><a href="/privacy-policy/">Privacy policy</a> · <a href="/terms/">Terms</a></span>
    </div>
  </div>
</footer>
