---
import { SERVICES, SERVICE_GROUPS, serviceUrl, type ServiceGroup } from '../data/services';
interface Props { headingLevel?: 'h2' | 'h3'; showBlurb?: boolean }
const { headingLevel = 'h3', showBlurb = true } = Astro.props;
const groups = Object.keys(SERVICE_GROUPS) as ServiceGroup[];
const H = headingLevel;
const Sub = headingLevel === 'h2' ? 'h3' : 'h4';
---
<div class="svc-groups">
  {groups.map((g) => {
    const items = SERVICES.filter((s) => s.group === g);
    return (
      <section class="svc-group" id={`svc-group-${g}`} aria-labelledby={`svc-group-title-${g}`}>
        <div class="svc-group__head">
          <div class="svc-group__title-row">
            <H id={`svc-group-title-${g}`} class="svc-group__title">{SERVICE_GROUPS[g].label}</H>
            <span class="svc-group__count">{items.length} {items.length === 1 ? 'service' : 'services'}</span>
          </div>
          {showBlurb && <p class="svc-group__blurb">{SERVICE_GROUPS[g].blurb}</p>}
        </div>
        <div class="svc-group__grid">
          {items.map((s) => (
            <a class="svc-card" href={serviceUrl(s.slug)}>
              <Sub class="svc-card__title">{s.name}</Sub>
              <p class="svc-card__summary">{s.summary}</p>
              <span class="svc-card__more" aria-hidden="true">View service</span>
            </a>
          ))}
        </div>
      </section>
    );
  })}
</div>
