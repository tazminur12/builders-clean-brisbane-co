---
import Icon from './Icon.astro';
import { NAV, SITE, hasPhone, telHref } from '../config/site';

const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="site-header on-teal">
  <div class="wrap site-header__inner">
    <a class="site-header__logo" href="/" aria-label={`${SITE.name} home`}>
      <img src="/brand/logo-horizontal-reversed.svg" alt={SITE.name} width="551" height="168" />
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-nav-toggle>
      <Icon name="menu" class="nav-toggle__open" /><span>Menu</span>
    </button>
    <nav class="site-nav" id="site-nav" aria-label="Main">
      <ul>
        {NAV.map((item) => (
          <li><a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
      <div class="site-nav__cta">
        {hasPhone
          ? <a class="btn btn--lime" href={telHref} style="width:100%"><Icon name="phone" />Call {SITE.phoneDisplay}</a>
          : <a class="btn btn--lime" href="/contact/#quote" style="width:100%"><Icon name="quote" />Get a free quote</a>}
      </div>
    </nav>
    {hasPhone
      ? <a class="btn btn--lime site-header__cta" href={telHref}><Icon name="phone" />{SITE.phoneDisplay}</a>
      : <a class="btn btn--lime site-header__cta" href="/contact/#quote">Get a quote</a>}
  </div>
</header>
