---
import Breadcrumbs from './Breadcrumbs.astro';
import Photo from './Photo.astro';
import type { Crumb } from '../lib/schema';
import type { PhotoKey } from '../data/photos';

interface Props {
  crumbs?: Crumb[];
  h1: string;
  eyebrow?: string;
  lead?: string;
  photo?: PhotoKey;
  photoAlt?: string;
}
const { crumbs, h1, eyebrow, lead, photo, photoAlt } = Astro.props;
---
<section class:list={['page-head on-teal', { 'page-head--plain': !photo }]}>
  <div class="wrap">
    {crumbs && <Breadcrumbs crumbs={crumbs} />}
    <div class="page-head__grid">
      <div class="page-head__copy">
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        <h1>{h1}</h1>
        {lead && <p class="lead">{lead}</p>}
        <slot />
      </div>
      {photo && (
        <div class="page-head__media">
          <Photo photo={photo} alt={photoAlt} caption={false} eager crop={[5, 4]} sizes="(min-width: 900px) 520px, 100vw" widths={[360, 540, 720, 860, 1080]} />
        </div>
      )}
    </div>
  </div>
</section>
